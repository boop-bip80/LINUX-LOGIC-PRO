#!/bin/sh
set -e

case "$#:${1-}" in
    0:) ARG='-b' ;;
    1:--dsc) ARG='-S -d' ;;
    1:--help|1:-h) echo "Usage: $0 [--dsc]"; exit 0 ;;
    *) echo "Usage: $0 [--dsc]" >&2; exit 2 ;;
esac

. ./tools/debian/package-common.sh
write_daily_changelog
if [ "$ARG" = '-S -d' ]; then
    write_orig_archive
fi

debuild --preserve-envvar 'CCACHE_*' --no-lintian -us -uc $ARG
